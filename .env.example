DATABASE_URL=postgresql://conc:conc@127.0.0.1:5432/conciliador
REDIS_URL=redis://127.0.0.1:6379

ANTHROPIC_API_KEY=coloque-sua-chave-aqui
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modelo mais barato para extrair dados de e-mails (fase 3)
EXTRATOR_MODEL=claude-haiku-5-5

# Opcional: crie um projeto grátis em https://cloud.langfuse.com e cole as chaves.
# Sem elas, o agente roda normalmente, só sem rastreamento.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
