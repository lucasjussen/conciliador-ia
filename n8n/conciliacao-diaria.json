{
  "name": "Conciliação diária",
  "active": false,
  "nodes": [
    {
      "id": "a1f0c0de-0001-4c1a-9a00-000000000001",
      "name": "Dias úteis às 7h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "a1f0c0de-0006-4c1a-9a00-000000000006",
      "name": "Rodar agora (teste)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        160
      ],
      "parameters": {}
    },
    {
      "id": "a1f0c0de-0002-4c1a-9a00-000000000002",
      "name": "Rodar conciliação",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/conciliar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "a1f0c0de-0003-4c1a-9a00-000000000003",
      "name": "Tem divergência?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c0nd-0001",
              "leftValue": "={{ $json.total }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a1f0c0de-0004-4c1a-9a00-000000000004",
      "name": "Enviar resumo por e-mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        -100
      ],
      "parameters": {
        "fromEmail": "conciliador@seu-dominio.com.br",
        "toEmail": "financeiro@seu-dominio.com.br",
        "subject": "=Conciliação {{ $json.data_base }}: {{ $json.texto }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}<p>Detalhes: GET /divergencias na API do conciliador.</p>",
        "options": {}
      }
    },
    {
      "id": "a1f0c0de-0005-4c1a-9a00-000000000005",
      "name": "Sem divergências",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        100
      ],
      "parameters": {}
    }
  ],
  "connections": {
